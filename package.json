{
  "name": "hr-assistant",
  "version": "1.0.0",
  "private": true,
  "engines": { "node": ">=22 <25" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3001",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/init-db.mjs",
    "db:migrate": "node scripts/init-db.mjs --schema-only"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mammoth": "^1.9.0",
    "next": "^15.4.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "unpdf": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
